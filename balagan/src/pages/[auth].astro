---
import Balagan from '../layouts/Balagan.astro';
import { handoff, handoffPath, signedIn } from '../lib/hub.mjs';
export const prerender = false;
const mode = Astro.params.auth;
if (mode !== 'signin' && mode !== 'register') return new Response(null,{status:404});
const info = handoff(Astro.url.searchParams);
if (await signedIn(Astro.cookies)) return Astro.redirect(handoffPath(info),303);
Astro.response.headers.set('Cache-Control','no-store');
// Same-origin form posts need an Origin header for CSRF validation.
Astro.response.headers.set('Referrer-Policy','same-origin');
const title = mode === 'register' ? 'Create your Balagan account' : 'Sign in to Balagan';
const other = mode === 'register' ? 'signin' : 'register';
const code = Astro.url.searchParams.get('error');
const errors = new Map([
 ['format','Use a username of 3–24 letters, numbers, underscores or hyphens, and a password of 12–128 characters.'],
 ['rate','Too many attempts. Try again in a few minutes.'],
 ['username','That username is taken. Choose another.'],
 ['credentials','The username or password didn’t match.']
]);
---
<Balagan title={title}>
  <h1>{title}</h1>
  <p>One account for Thiskicks, Wemember, Sorriest and Barara.</p>
  <div class="panel auth-panel">
    {code && errors.has(code) && <p class="notice" role="alert">{errors.get(code)}</p>}
    <form method="post" action="/api/account">
      <input type="hidden" name="mode" value={mode}>
      {info && Object.entries(info).map(([name,value]) => <input type="hidden" name={name} value={value}>)}
      <label for="username">Username</label>
      <input id="username" name="username" required autocomplete="username" minlength="3" maxlength="24" spellcheck="false" autocapitalize="none" aria-describedby={mode === 'register' ? 'username-status' : undefined}>
      {mode === 'register' && <p class="field-hint" id="username-status" role="status">Use 3–24 letters, numbers, underscores or hyphens.</p>}
      <label for="password">Password</label>
      <input id="password" name="password" type="password" required minlength="12" maxlength="128" autocomplete={mode === 'register' ? 'new-password' : 'current-password'} aria-describedby={mode === 'register' ? 'password-status' : undefined}>
      {mode === 'register' && <p class="field-hint" id="password-status" role="status">Use at least 12 characters. A long, unique passphrase works well.</p>}
      <button>{mode === 'register' ? 'Create account' : 'Sign in'}</button>
    </form>
    <p><a href={'/'+other+(info ? '?' + new URLSearchParams(info) : '')}>{other === 'signin' ? 'Already have an account? Sign in' : 'Create an account'}</a></p>
  </div>
</Balagan>

<script>
import { validUsername } from '../lib/accounts.mjs';

const username = document.querySelector<HTMLInputElement>('#username');
const usernameStatus = document.getElementById('username-status');
if (username && usernameStatus) {
  let timer: ReturnType<typeof setTimeout>;
  let controller: AbortController;
  username.addEventListener('input', () => {
    clearTimeout(timer);
    controller?.abort();
    const name = username.value.trim();
    if (!validUsername(name)) {
      usernameStatus.textContent = 'Use 3–24 characters. Start with a letter or number.';
      return;
    }
    const check = new AbortController();
    controller = check;
    usernameStatus.textContent = 'Checking username…';
    timer = setTimeout(async () => {
      try {
        const response = await fetch('/api/username-availability?' + new URLSearchParams({username:name}), {signal:check.signal});
        if (!response.ok) throw new Error();
        const {available} = await response.json();
        if (!check.signal.aborted) usernameStatus.textContent = available ? 'Username available.' : 'That username is already taken.';
      } catch {
        if (!check.signal.aborted) usernameStatus.textContent = 'Availability will be checked when you submit.';
      }
    }, 350);
  });
}

const password = document.querySelector<HTMLInputElement>('#password');
const passwordStatus = document.getElementById('password-status');
if (password && passwordStatus) {
  password.addEventListener('input', () => {
    const value = password.value;
    if (value.length < 12) {
      passwordStatus.textContent = `Use at least 12 characters (${value.length} so far).`;
    } else if (value.length < 16 || new Set(value.toLowerCase()).size < 6 || /^(password|qwerty|123456)/i.test(value)) {
      passwordStatus.textContent = 'Length requirement met. Try a longer, less predictable passphrase.';
    } else {
      passwordStatus.textContent = 'Length requirement met. Use a unique passphrase you haven’t used elsewhere.';
    }
  });
}
</script>

<style>
.field-hint { margin: 4px 0 12px; font-size: .875rem; min-height: 1.5em; }

@media (max-width: 420px) {
  h1 {
    font-size: clamp(2rem, 9vw, 2.5rem);
    line-height: 1.08;
  }

  .auth-panel button {
    width: 100%;
    justify-content: center;
  }
}
</style>
