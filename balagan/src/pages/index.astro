---
import Balagan from '../layouts/Balagan.astro';
import { money, offers } from '../lib/offers.mjs';

const games = [
  {
    name: 'Wemember', kind: 'Voice memory', href: 'https://wemember.balagan.live/',
    setup: 'Host reads a short script into a private room. Friends listen once and type the details they remember. Accuracy wins, with speed as the tiebreaker.',
    entry: 'First challenge free per UTC day, then 15 tokens each.',
    rewards: '15, 8 and 5 tokens for the top three eligible players.',
  },
  {
    name: 'Sorriest', kind: 'Daily writing contest', href: 'https://sorriest.balagan.live/',
    setup: 'Join a fictional scandal, write a short apology, then vote on another entrant’s response. Each contest has a full day to write and another to vote.',
    entry: 'Free to browse. 20 tokens to enter a contest.',
    rewards: '5–20 tokens for up to ten apologies that receive votes.',
  },
  {
    name: 'Barara', kind: 'Private courtroom', href: 'https://bar.ara.balagan.live/',
    setup: 'Open a private court for a petty fictional dispute. Two friends argue their sides and up to five jurors decide the case in ten minutes.',
    entry: '30 tokens per player, including the host and jurors.',
    rewards: '20 for the winner and 15 per winning-side juror, with at least three ballots.',
  },
  {
    name: 'Thiskicks', kind: 'Public pitch board', href: 'https://thiskicks.balagan.live/',
    setup: 'Pitch a product idea, share its link and see what people would buy or change. Published pitches are public and permanent.',
    entry: 'First pitch free, then 30 tokens per pitch. Comments and voting are free.',
    rewards: 'Monthly top pitches earn 30–350 tokens. Equal votes share the prizes for their tied positions.',
  },
];
const gameActions = {
  Wemember: {line:'How much can you remember after one listen?', first:'Try one listen', firstPath:'#practice', second:'Host a room', secondPath:'challenge/new'},
  Sorriest: {line:'What would you say if you ate the last slice?', first:'Try an apology', firstPath:'#practice', second:'See today’s contests', secondPath:'daily'},
  Barara: {line:'Two sides. One missing cookie.', first:'Give a practice verdict', firstPath:'#practice', second:'Open a court', secondPath:'challenge/new'},
  Thiskicks: {line:'Would anyone buy your idea?', first:'Browse pitches', firstPath:'board', second:'Write a pitch', secondPath:'new'},
};
const packs = Object.values(offers).filter(offer => !offer.interval);
const memberships = Object.values(offers).filter(offer => offer.interval);
const period = {monthly:'per month',annual:'per year','two-year':'every two years'};
const membershipTerms = ['monthly','annual','two-year'];
---
<Balagan>
  <section class="section" id="games">
    <div class="section-intro">
      <h1>Pick what to play.</h1>
      <p>Three social games and a public pitch board.</p>
    </div>
    <div class="game-picker" data-game-picker>
      <div class="play-selector" aria-label="Select a game">
        {games.map(game => <a href={'#'+game.name.toLowerCase()} data-choice={game.name.toLowerCase()}>{game.name}</a>)}
      </div>
      {games.map(game => {
        const id = game.name.toLowerCase();
        const actions = gameActions[game.name as keyof typeof gameActions];
        return <article class:list={['game-stage',id]} id={id} data-game={id}>
          <div class="game-copy">
            <p class="game-kind">{game.kind}</p>
            <h3>{game.name}</h3>
            <p class="game-line">{actions.line}</p>
            <div class="actions">
              <a class="button" href={game.href+actions.firstPath}>{actions.first}</a>
              <a href={game.href+actions.secondPath}>{actions.second}</a>
            </div>
            <section class="game-rules"><h4>How it works</h4>
              <p>{game.setup}</p>
              <dl><dt>Entry</dt><dd>{game.entry}</dd><dt>Earn tokens</dt><dd>{game.rewards}</dd></dl>
            </section>
          </div>
          <img src={'/media/'+id+'-wide.png'} alt="" width="1672" height="941" loading="lazy">
        </article>;
      })}
    </div>
  </section>

  <section class="hero">
    <div>
      <h2>Make a little trouble with friends.</h2>
      <p>Balagan brings together three social games and a public pitch board. One account gets you into all four, and one wallet holds the tokens you buy and win.</p>
      <div class="actions"><a class="button" href="/register">Create a free account</a><a href="#games">Back to games</a></div>
    </div>
    <img src="/media/balagan-wide.png" alt="Friends laughing around a games table" width="1672" height="941" loading="lazy">
  </section>

  <section class="section earn-section" id="earn">
    <h2>Play. Place. Earn tokens.</h2>
    <p>Game rewards go into your Balagan wallet. Spend them on another game or your next Thiskicks pitch.</p>
    <a class="button" href="/earn">See how to earn tokens</a>
  </section>
  <section class="section" id="tokens">
    <div class="section-intro"><h2>One wallet for all four</h2><p>Tokens pay for game entry and extra Thiskicks pitches. When you place in a game, your rewards go into the same wallet. Signing up is free.</p></div>
    <div class="pricing">
      <section><h3>One-time packs</h3><dl>
        {packs.map(offer => <div><dt>{offer.tokens} tokens</dt><dd>{money(offer.cents)}</dd></div>)}
      </dl><p>Pack tokens and game rewards stay in your wallet until spent.</p></section>
      <section><h3>Optional monthly refills</h3><dl>
        {memberships.map((offer,i) => <div><dt>{offer.tokens.toLocaleString('en-US')} tokens/month</dt><dd>{money(offer.cents)} {period[membershipTerms[i]]}</dd></div>)}
      </dl><p>Every plan refills monthly. Unused subscription tokens don’t roll over.</p></section>
    </div>
    <a class="button" href="/wallet">Open your wallet</a>
  </section>

  <aside class="elsewhere">
    <h2>Also on Balagan</h2>
    <p><a href="https://xmincing-ypoppy.balagan.live">XMincing</a> turns a group’s answers into a song and works without a Balagan sign-in. <a href="https://orach-travel.balagan.live">Orach</a> helps you plan a trip and uses its own sign-in. Each handles its own payments.</p>
  </aside>
</Balagan>
<script>
  const picker = document.querySelector('[data-game-picker]');
  if (picker) {
    const choices = [...picker.querySelectorAll<HTMLAnchorElement>('[data-choice]')];
    const games = [...picker.querySelectorAll<HTMLElement>('[data-game]')];
    function select(id: string) {
      for (const game of games) game.hidden = game.dataset.game !== id;
      for (const choice of choices) {
        if (choice.dataset.choice === id) choice.setAttribute('aria-current','true');
        else choice.removeAttribute('aria-current');
      }
    }
    const hasGame = (id: string) => games.some(game => game.dataset.game === id);
    select(hasGame(location.hash.slice(1)) ? location.hash.slice(1) : 'wemember');
    picker.addEventListener('click', event => {
      const link = (event.target as Element).closest<HTMLAnchorElement>('[data-choice]');
      if (!link?.dataset.choice || event.defaultPrevented || (event instanceof MouseEvent &&
        (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey))) return;
      event.preventDefault();
      history.replaceState(null,'',link.hash);
      select(link.dataset.choice);
    });
    window.addEventListener('hashchange', () => {
      if (hasGame(location.hash.slice(1))) select(location.hash.slice(1));
    });
  }
</script>
<style>
.hero{margin-top:clamp(36px,6vw,66px);display:grid;grid-template-columns:minmax(0,1.03fr) minmax(0,1fr);background:#3b1436;color:#fff4dc;border-radius:10px;overflow:hidden}
.hero>div{align-self:center;padding:clamp(20px,4.4vw,56px)}
.hero h2{font-family:Georgia,serif;font-size:clamp(2rem,4vw,3.65rem)}
.hero p{font-size:1.06em;max-width:39ch}
.hero img{display:block;width:100%;height:100%;object-fit:cover;object-position:60% center}
.actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px}
.actions>a{min-height:44px;display:inline-flex;align-items:center}
.section{margin-top:clamp(44px,7vw,86px)}
.section-intro{margin-bottom:24px}
.section-intro>p{margin:0}
#games{margin-top:0}
#games h1{font-family:Georgia,serif;font-size:clamp(2.65rem,6vw,5.2rem);margin-bottom:10px}
#games .section-intro{margin-bottom:18px}
@media(max-width:540px){#games .section-intro{margin-bottom:12px}.game-copy{padding:16px}.game-copy p{margin-block:8px}}
.game-picker{padding:clamp(10px,2vw,20px);border:1px solid #bba1c6;border-radius:12px;background:#fff7ff}
.play-selector{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-bottom:12px}
.play-selector a{display:grid;place-items:center;text-align:center;min-height:44px;padding:6px;border:1px solid #bba1c6;border-radius:5px;font-weight:750;text-decoration:none}
.play-selector a:hover,.play-selector a[aria-current]{background:#3b1436;color:#fff4dc}
.game-stage{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,1fr);border-radius:8px;overflow:hidden;margin-bottom:10px}
.game-stage[hidden]{display:none}
.game-stage:last-child{margin-bottom:0}
.game-copy{padding:clamp(19px,4vw,42px)}
.game-stage.wemember{background:#e8def7;color:#31224d}
.game-stage.sorriest{background:#ffdfe4;color:#501329}
.game-stage.barara{background:#dceee8;color:#103f39}
.game-stage.thiskicks{background:#edf3d8;color:#263219}
.game-stage h3{font-family:Georgia,serif;font-size:clamp(2.3rem,6vw,4.5rem);margin:.12em 0}
.game-kind{font-size:.88em;font-weight:650;margin:0}
.game-line{font-size:1.16em;font-weight:750;margin:.45em 0}
.game-stage img{width:100%;height:100%;object-fit:cover}
.game-rules{border-top:1px solid currentColor;margin-top:18px;padding-top:10px}
.game-rules h4{margin:0 0 10px;font-size:1rem}
.game-stage dt{font-weight:750}
.game-stage dd{margin:0 0 6px}
.pricing{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-bottom:16px}
.pricing section{background:#fff7ff;border-top:4px solid #3b1436;padding:clamp(15px,3vw,28px)}
.pricing dl{margin:12px 0}
.pricing dl>div{display:flex;flex-wrap:wrap;justify-content:space-between;gap:4px 10px;padding:6px 0;border-bottom:1px solid #d9c7de}
.pricing dd{margin:0;font-weight:750}
.elsewhere{margin-top:45px;border-top:1px solid #bba1c6;padding-top:20px}
.elsewhere h2{font-size:26px}
@media(max-width:800px){.hero{grid-template-columns:minmax(0,1fr)}.hero img{height:auto;aspect-ratio:16/9;max-height:345px}.game-stage{grid-template-columns:minmax(0,1fr)}.game-stage img{height:auto;aspect-ratio:16/9}}
@media(max-width:540px){.pricing{grid-template-columns:minmax(0,1fr)}.play-selector{grid-template-columns:repeat(2,minmax(0,1fr))}}
.earn-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px;margin:26px 0}
.earn-grid article{padding:26px;background:#fff7ff;border:1px solid #d9c7de;border-radius:12px}
.earn-grid h3{font-size:24px}.earn-grid strong{font-size:27px}.earn-grid p{margin-bottom:0}
.game-rules dl{display:grid;gap:5px}.game-rules dd{margin-bottom:12px}
@media(max-width:800px){.earn-grid{grid-template-columns:1fr}}
</style>
