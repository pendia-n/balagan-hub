---
import Balagan from '../layouts/Balagan.astro';
const games = [
  ['thiskicks','Thiskicks','Pitch your invention and see what people think.','https://thiskicks.balagan.live'],
  ['wemember','Wemember','Listen once. See how many details you remember.','https://wemember.balagan.live'],
  ['sorriest','Sorriest','Give the press your best apology for a fictional scandal.','https://sorriest.balagan.live'],
  ['barara','Barara','Put the missing cookie on trial in a private court.','https://bar.ara.balagan.live'],
  ['xmincing','XMincing','Turn your group’s answers into a song.','https://xmincing-ypoppy.balagan.live']
];
---
<Balagan>
  <section class="hero">
    <div><h1>Something to play together.</h1><p>Pitch a strange invention, remember one recording, or put the last cookie on trial.</p><a class="button" href="#games">Browse games</a> <a class="signup" href="/register">Create an account</a></div>
    <img src="/media/balagan-wide.png" alt="Friends laughing around a games table" width="1672" height="941" fetchpriority="high">
  </section>
  <section id="games">
    <h2>Pick a game</h2>
    <div class="grid">
      {games.map(([id,name,copy,href]) => <a class="poster" href={href}><img src={'/media/'+id+'-wide.png'} alt="" width="1672" height="941" loading="lazy"><div><h3>{name}</h3><p>{copy}</p></div></a>)}
    </div>
    <p class="travel">Looking for travel planning? <a href="https://orach-travel.balagan.live">Open Orach</a> · Separate sign-in.</p>
  </section>
</Balagan>
<style>
.hero{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);background:#3b1436;color:#fff4dc;border-radius:10px;overflow:hidden} .hero div{align-self:center;padding:clamp(24px,4.2vw,58px)} .hero p{font-size:20px;margin-bottom:22px}.signup{display:inline-block;margin:5px 0 4px 7px;font-size:15px}.hero img{height:100%;min-height:400px;object-fit:cover;object-position:65% center}img{display:block;width:100%;height:auto}#games{margin-top:48px}.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:18px}.poster{grid-column:span 2;background:#fff7ff;border:1px solid #c8adce;border-radius:6px;overflow:hidden;text-decoration:none}.poster:nth-child(-n+2){grid-column:span 3}.poster:hover{box-shadow:4px 4px #30143c}.poster div{padding:19px}.poster p{margin:0}.travel{margin-top:24px}
@media(max-width:820px){.hero{grid-template-columns:minmax(0,1fr)}.hero img{height:auto;min-height:0;max-height:360px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.poster,.poster:nth-child(-n+2){grid-column:span 1}}@media(max-width:480px){.grid{grid-template-columns:1fr}}
</style>
