---
const { title = 'Balagan' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <link rel="icon" href="/favicon.ico?v=brand-1" type="image/x-icon">
</head>
<body>
<header><nav><a class="brand" href="/"><img src="/media/balagan-logo.svg" alt="" width="44" height="44">Balagan</a><div><a href="/#games">Games</a><a href="/earn">Earn tokens</a><a href="/wallet">Wallet</a><a href="/account">Account</a></div></nav></header>
<main><slot /></main>
<footer>Balagan · Make a little trouble with friends.</footer>
</body>
</html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#f5eaff;color:#30143c;font:17px/1.55 system-ui,sans-serif}a{color:inherit}header{border-bottom:1px solid #c8adce}nav,main,footer{width:min(1180px,calc(100% - 32px));margin:auto}nav{display:flex;justify-content:space-between;align-items:center;min-height:70px}nav div{display:flex;gap:20px}nav a{text-decoration:none;font-weight:700}.brand{display:inline-flex;align-items:center;gap:10px}.brand img{display:block;object-fit:contain}.brand{font-size:27px;font-weight:900;letter-spacing:-.07em}main{padding:36px 0 64px;min-height:72vh}footer{border-top:1px solid #c8adce;padding:22px 0}h1,h2,h3{line-height:1;letter-spacing:-.05em}h1{font-size:clamp(39px,5.3vw,76px);margin:0 0 23px}h2{font-size:clamp(30px,4vw,56px);margin:0 0 18px}h3{font-size:27px;margin:0 0 10px}p{max-width:55ch}.button,button{display:inline-flex;background:#ffce72;color:#30143c;border:1px solid #30143c;min-height:44px;padding:9px 16px;align-items:center;font:inherit;font-weight:800;text-decoration:none;border-radius:4px;cursor:pointer}.button:hover,button:hover{box-shadow:3px 3px 0 #853b70}:focus-visible{outline:3px solid #a73577;outline-offset:4px}label{display:block;font-weight:700;margin-top:12px}input{display:block;width:100%;margin-top:4px;padding:11px;border:1px solid #a481ab;border-radius:4px;font:inherit}form{max-width:480px}form button{margin-top:18px}.notice{padding:12px 16px;background:#ffce72;border-left:4px solid #30143c}.panel{padding:clamp(20px,5vw,40px);background:#fff7ff;border:1px solid #c8adce;border-radius:8px;max-width:680px}

@media (max-width: 420px) {
  nav {
    flex-direction: column;
    align-items: stretch;
    gap: 2px;
    padding: 10px 0 4px;
  }

  .brand {
    align-self: flex-start;
  }

  nav div {
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 16px;
  }

  nav div a {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  main {
    padding-top: 26px;
  }
}
body{font-size:16px;line-height:1.65}
main{padding-top:40px}
h1,h2,h3{letter-spacing:-.035em}
button,.button{border-radius:8px;transition:transform .15s,box-shadow .15s}
button:hover,.button:hover{transform:translateY(-2px)}
.panel{border-radius:12px}
@media(prefers-reduced-motion:reduce){button,.button{transition:none}}
</style>
